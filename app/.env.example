# Projet Supabase partagé (DraftMaster / Quiz / Immo Brest). Variables serveur uniquement.
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# Mot de passe du site privé et secret de signature des sessions (32 octets hexadécimaux au moins).
SITE_PASSWORD=choisir_un_mot_de_passe_solide
SESSION_SECRET=generer_avec_node_-e_"console.log(require('crypto').randomBytes(32).toString('hex'))"
