# Projet Supabase partagé (DraftMaster / Quiz / Immo Brest)
SUPABASE_URL=https://votre-projet.supabase.co
# Clé service_role : pipeline uniquement (scripts locaux, GitHub Actions). Jamais dans le site.
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# Analyse IA des annonces (clés Gemini gratuites, séparées par des virgules ; mêmes clés que DraftMaster)
GEMINI_API_KEYS=cle1,cle2
GEMINI_MODEL=gemini-3.6-flash
# Secours payant quand les clés Gemini sont épuisées (texte seulement)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Notifications e-mail (Gmail SMTP, mot de passe d'application)
SMTP_USER=lyra.titou@gmail.com
SMTP_APP_PASSWORD=mot_de_passe_application_16_caracteres
NOTIFY_TO=lyra.titou@gmail.com
